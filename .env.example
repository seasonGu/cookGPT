# ===== cookGPT 环境变量(复制为 .env 后填写,启动时自动加载)=====

# --- 应用 ---
# 随机值生成: openssl rand -hex 32
COOKGPT_SECRET=please-change-me

# --- Embedding:硅基流动 bge-m3 ---
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxx
# EMBED_MODEL=BAAI/bge-m3
# EMBED_BATCH_SIZE=32        # 单次 API 请求的文本条数(限速时调小)
# EMBED_MAX_RETRIES=5

# --- LLM 问答生成:DeepSeek V4 官方 API(api.deepseek.com)---
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_MODEL=deepseek-v4-flash   # 默认;需要更强推理时换 deepseek-v4-pro
# LLM_BASE_URL=https://api.deepseek.com/chat/completions

# --- MySQL(腾讯云内网地址)---
MYSQL_HOST=10.0.x.x
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=xxxxxxxx
MYSQL_DB=cookgpt

# --- Milvus Lite ---
# 数据目录必须放持久盘(云服务器重启/重装不丢),默认 backend/data/milvus
# COOKGPT_MILVUS_DIR=/data/cookgpt/milvus
